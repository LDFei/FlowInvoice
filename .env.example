# 本地开发环境变量模板 —— 复制为 .env 后按需修改（.env 已被 gitignore，本文件可提交）
# 数据库连接串：连 docker compose 起的 pgvector 库（账号/库名见 docker-compose.yml）
FLOWINVOICE_PG_DSN=postgresql://flowinvoice:flowinvoice_dev@localhost:5432/flowinvoice
# 向量检索 DSN（可选）：不设则复用主库 DSN；单独设置可"主库留 SQLite、只开向量 RAG"
# FLOWINVOICE_RAG_VECTOR_DSN=postgresql://flowinvoice:flowinvoice_dev@localhost:5432/flowinvoice
# RAG 开关：0/false 关闭（纯 BM25），1/true 开启混合检索
FLOWINVOICE_RAG_ENABLED=1

# ---- 对象存储 MinIO（docs/06 Phase 2）：不设 ENDPOINT → 源文件落本地 data/objects 替身 ----
# FLOWINVOICE_MINIO_ENDPOINT=localhost:9000
# FLOWINVOICE_MINIO_ACCESS_KEY=minioadmin
# FLOWINVOICE_MINIO_SECRET_KEY=minioadmin
# FLOWINVOICE_MINIO_BUCKET=flowinvoice
# FLOWINVOICE_MINIO_SECURE=0
# LLM 接入（DeepSeek，OpenAI 兼容）：无 key 时全链路自动降级确定性规则，不影响 Demo 运行。
# 密钥只放 .env（gitignored），本文件仅占位。
FLOWINVOICE_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLOWINVOICE_LLM_MODEL=deepseek-v4-flash
# 可选：自定义 API 地址（默认 https://api.deepseek.com）
# FLOWINVOICE_LLM_BASE_URL=https://api.deepseek.com

# ---- 技术日志（app/core/logging.py） ----
# 日志级别：DEBUG 可见图结构/检索详情；生产建议 INFO
FLOWINVOICE_LOG_LEVEL=INFO
# 日志目录（轮转文件，10MB×5 默认）
# FLOWINVOICE_LOG_DIR=logs
